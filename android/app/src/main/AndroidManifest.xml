<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- specialUse, а НЕ dataSync: у dataSync в Android 15 суточный лимит
         около шести часов, после которого система гасит службу. Постоянный
         сокет под таким лимитом не живёт — ночь он бы не пережил в любом
         случае, и тест перестал бы что-либо значить. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Захват экрана (ступень 3): с Android 14 служба обязана объявить и
         этот тип, иначе система не отдаст проекцию вовсе. Согласие человека
         при этом всё равно спрашивается каждый раз — отключить это нечем. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Звук телефона (ступень 6). Это не микрофон: захватывается системный
         звук через ту же проекцию, но Android считает это записью, поэтому
         и разрешение, и тип службы нужны те же. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Камера и микрофон — не «на всякий случай»: без них страницы сайта,
         просящие их через getUserMedia, в WebView просто не работают.
         Разрешение всё равно спрашивается у человека в момент запроса. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Самообновление: магазина нет, ставить сборку предлагает само
         приложение. Установку всё равно подтверждает система. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Файлы телефона (ступень 4). В отличие от захвата экрана это
         разрешение даётся один раз в настройках и живёт постоянно: телефон
         может лежать в кармане, участия человека при работе не требуется. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".VgApp"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VgAgent">

        <!-- Оболочка: сайт внутри приложения. Единственный видимый экран. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Служебный экран с журналом: открывается долгим тычком по полоске
             состояния. В списке приложений его нет — это отладка, не витрина. -->
        <activity
            android:name=".AgentActivity"
            android:exported="false"
            android:label="@string/agent_screen" />

        <!-- Приём «Поделиться». В PWA это делал share_target из манифеста;
             внутри оболочки манифест никто не читает, поэтому обычный
             intent-filter. Типы перечислены так же широко, как в манифесте
             сайта: на голый "*/*" Android часто не показывает приложение при
             отправке документов и архивов. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.VgAgent.Invisible">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".AgentService"
            android:exported="false"
            android:foregroundServiceType="specialUse|mediaProjection|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Постоянное исходящее соединение с личным сайтом владельца телефона: телефон не может принимать входящие (CGNAT у оператора), поэтому держит открытый сокет сам." />
        </service>

        <!-- Управление пальцем с ПК (ступень 5). Включает её человек сам,
             в настройках спец-возможностей: другого законного способа
             нажимать за него у приложения нет. -->
        <service
            android:name=".TouchService"
            android:exported="true"
            android:label="@string/touch_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/touch_service" />
        </service>

        <!-- Перезагрузка телефона не должна означать «агент умер»: ночной
             тест может начаться с неё же. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
