{
  "name": "vitazgio-desktop",
  "version": "0.1.1",
  "private": true,
  "description": "Vitaz Gio — сайт, музыка и удалённый экран Windows",
  "author": "VITAZGIO",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": { "koffi": "3.3.0" },
  "devDependencies": { "electron": "44.4.1", "electron-builder": "26.15.3" },
  "build": {
    "appId": "ru.vitazgio.desktop",
    "productName": "Vitaz Gio",
    "artifactName": "vitazgio-windows-${version}-x64.exe",
    "files": ["*.cjs", "*.html", "assets/**", "package.json"],
    "asarUnpack": ["node_modules/koffi/**"],
    "win": { "target": "nsis", "icon": "assets/icon.ico", "signAndEditExecutable": true },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "deleteAppDataOnUninstall": false }
  }
}
